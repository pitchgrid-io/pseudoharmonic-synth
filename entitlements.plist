<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow dlopen() of dylibs not signed by our team, e.g. ODDSound's
         /Library/Audio/Plug-Ins/Libraries/libMTS.dylib loaded at runtime
         by libMTSClient. Without this, hardened runtime's library
         validation silently rejects the dlopen and MTS-ESP master
         detection fails. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
